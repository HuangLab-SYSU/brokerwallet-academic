<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="VideoText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="VideoHeading" parent="VideoText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="VideoPanel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/video_panel</item>
    </style>
    <style name="VideoInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">70dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/video_panel</item>
        <item name="android:padding">14dp</item>
        <item name="android:hint">0</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textColorHint">#CBD2DC</item>
    </style>
    <style name="VideoAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/video_button_disabled</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:enabled">false</item>
    </style>
    <style name="VideoSlip">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/video_tab_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="VideoPercent">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">#E3E6EB</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#374151</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="VideoHistoryToggle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>