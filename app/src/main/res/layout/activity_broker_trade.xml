<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F8FC">
    <include layout="@layout/topbar" />
    <include layout="@layout/include_token_sub_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/action_bar" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/token_refresh" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/token_sub_header">
        <androidx.core.widget.NestedScrollView android:id="@+id/trade_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/trade_scroll_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
                <LinearLayout android:id="@+id/trade_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp" android:orientation="horizontal" android:visibility="gone" android:background="@drawable/video_panel" android:padding="2dp">
                    <Button android:id="@+id/trade_tab_swap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="Swap" android:textAllCaps="false" android:textSize="13sp" android:background="@android:color/transparent" android:backgroundTint="@null" android:textColor="@color/video_tab_text" android:minWidth="0dp" android:minHeight="40dp" android:padding="0dp" />
                    <Button android:id="@+id/trade_tab_liquidity" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="Provide Liquidity" android:textAllCaps="false" android:textSize="13sp" android:background="@android:color/transparent" android:backgroundTint="@null" android:textColor="@color/video_tab_text" android:minWidth="0dp" android:minHeight="40dp" android:padding="0dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/trade_swap_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/token_pay_label" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" />
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clipChildren="false" android:clipToPadding="false">
                        <LinearLayout android:id="@+id/token_pay_card" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" android:background="@drawable/video_panel" android:gravity="center_vertical" android:minHeight="112dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                            <EditText android:id="@+id/token_pay_amount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:gravity="center_vertical" android:hint="0" android:inputType="numberDecimal" android:minHeight="56dp" android:textColor="#111827" android:textColorHint="#CBD5E1" android:textSize="36sp" android:singleLine="true" />
                            <LinearLayout android:id="@+id/token_pay_token_selector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/token_selector_press_feedback" android:clickable="true" android:focusable="true" android:gravity="end" android:minWidth="116dp" android:orientation="vertical" android:paddingStart="4dp" android:paddingTop="6dp" android:paddingEnd="0dp" android:paddingBottom="6dp">
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                    <TextView android:id="@+id/token_pay_token_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/token_list_icon_bg" android:gravity="center" android:text="B" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/token_pay_symbol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="BKC" android:textColor="#0F172A" android:textSize="15sp" android:textStyle="bold" />
                                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:contentDescription="@string/token_picker_open" android:src="@drawable/ic_token_chevron_down" />
                                </LinearLayout>
                                <TextView android:id="@+id/token_pay_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/token_balance_loading" android:textColor="#9CA3AF" android:textSize="10sp" />
                                <LinearLayout android:id="@+id/token_pay_max_container" android:layout_width="wrap_content" android:layout_gravity="end" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="vertical">
                                    <TextView android:id="@+id/token_pay_max" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/token_max_text_button" android:clickable="true" android:focusable="true" android:gravity="center" android:minHeight="18dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:text="Max" android:textColor="@drawable/token_max_text_color" android:textSize="10sp" android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:id="@+id/token_receive_section_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/token_receive_label" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold" app:layout_constraintBottom_toTopOf="@id/token_receive_card" app:layout_constraintStart_toStartOf="parent" />
                        <LinearLayout android:id="@+id/token_receive_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="80dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/token_pay_card" android:background="@drawable/video_panel" android:gravity="center_vertical" android:minHeight="112dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                            <HorizontalScrollView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fillViewport="false" android:scrollbars="none">
                                <TextView android:id="@+id/token_receive_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="56dp" android:maxLines="1" android:scrollHorizontally="true" android:singleLine="true" android:text="0" android:textColor="#111827" android:textSize="36sp" />
                            </HorizontalScrollView>
                            <LinearLayout android:id="@+id/token_receive_token_selector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/token_selector_press_feedback" android:clickable="true" android:focusable="true" android:gravity="end" android:minWidth="116dp" android:orientation="vertical" android:paddingStart="4dp" android:paddingTop="6dp" android:paddingEnd="0dp" android:paddingBottom="6dp">
                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                    <TextView android:id="@+id/token_receive_token_icon" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/token_list_icon_bg" android:gravity="center" android:text="W" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
                                    <TextView android:id="@+id/token_receive_symbol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="wBKC" android:textColor="#0F172A" android:textSize="15sp" android:textStyle="bold" />
                                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="2dp" android:contentDescription="@string/token_picker_open" android:src="@drawable/ic_token_chevron_down" />
                                </LinearLayout>
                                <TextView android:id="@+id/token_receive_balance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="4dp" android:text="@string/token_balance_loading" android:textColor="#9CA3AF" android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView android:id="@+id/token_swap_direction" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/token_swap_fab" android:clickable="true" android:contentDescription="@string/token_swap_direction_desc" android:elevation="4dp" android:focusable="true" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/jiaohuan" app:layout_constraintBottom_toTopOf="@id/token_receive_card" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/token_pay_card" app:layout_constraintVertical_bias="0.5" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout android:id="@+id/broker_swap_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rate" android:textColor="#6B7280" android:textSize="13sp" />
                            <TextView android:id="@+id/video_rate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading quote..." android:textColor="#111827" android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/video_slippage_row" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Slippage" android:textColor="#6B7280" android:textSize="13sp" />
                            <TextView android:id="@+id/video_slip_05" style="@style/VideoSlip" android:text="0.5%" />
                            <TextView android:id="@+id/video_slip_1" style="@style/VideoSlip" android:text="1%" />
                            <TextView android:id="@+id/video_slip_2" style="@style/VideoSlip" android:text="2%" />
                            <TextView android:id="@+id/video_slip_5" style="@style/VideoSlip" android:text="5%" />
                        </LinearLayout>
                        <TextView android:id="@+id/broker_swap_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6B7280" android:textSize="12sp" />
                        <TextView android:id="@+id/broker_swap_status" style="@style/VideoText" android:visibility="gone" />
                        <TextView android:id="@+id/trade_swap_feedback" style="@style/VideoText" android:visibility="gone" />
                        <TextView android:id="@+id/trade_asset_hint" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                        <Button android:id="@+id/broker_swap_slippage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                        <Button android:id="@+id/broker_swap_history" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    </LinearLayout>
                    <android.widget.Button android:id="@+id/token_confirm_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/video_button" android:backgroundTint="@null" android:enabled="false" android:letterSpacing="0" android:stateListAnimator="@null" android:text="Loading quote..." android:textAllCaps="false" android:textColor="@color/white" android:textSize="17sp" android:textStyle="bold" android:minHeight="52dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
                    <Button android:id="@+id/trade_swap_history_toggle" style="@style/VideoHistoryToggle" android:text="Swap History" android:visibility="gone" />
                    <LinearLayout android:id="@+id/trade_swap_history_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
                </LinearLayout>
                <include android:id="@+id/trade_liquidity_content" layout="@layout/include_trade_liquidity" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>