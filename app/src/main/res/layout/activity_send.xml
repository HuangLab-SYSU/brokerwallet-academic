<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".send.SendActivity">

    <!-- Top Bar -->
    <include
        layout="@layout/topbar"
        android:id="@+id/action_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title Section -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:text="@string/activity_send_send"
        android:fontFamily="@font/work_sans_black"
        android:textSize="@dimen/text_size_xlarge"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/action_bar" />

    <!-- Description Text -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:text="@string/activity_send_transfer_tip"
        android:textSize="@dimen/text_size_normal"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <!-- Scrollable Form Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_description"
        app:layout_constraintBottom_toTopOf="@id/btn_send">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Send From Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_send_send_from"
                android:textColor="#000000"
                android:textSize="@dimen/text_size_normal" />

            <!-- Send From Input -->
            <EditText
                android:id="@+id/edt_sendfrom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_edittext_border"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textSize="@dimen/text_size_normal" />

            <!-- Send To Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/activity_send_send_to"
                android:textColor="#000000"
                android:textSize="@dimen/text_size_normal" />

            <!-- Send To Input -->
            <EditText
                android:id="@+id/edt_sendto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_edittext_border"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textSize="@dimen/text_size_normal" />

            <!-- Amount Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/activity_send_amount"
                android:textColor="#000000"
                android:textSize="@dimen/text_size_normal" />

            <!-- Amount Input -->
            <EditText
                android:id="@+id/edt_amount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edittext_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/custom_edittext_border"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textSize="@dimen/text_size_normal" />

            <!-- Fee Label -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gas Price"
                android:textColor="#000000"
                android:textSize="@dimen/text_size_normal" />

            <!-- Gas Price Value Row -->
            <LinearLayout
                android:id="@+id/fee_value_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/edt_fee_value"
                    android:layout_width="96dp"
                    android:layout_height="@dimen/edittext_height"
                    android:background="@drawable/custom_edittext_border"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="50"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Gwei"
                    android:textColor="#000000"
                    android:textSize="@dimen/text_size_normal" />
            </LinearLayout>

            <!-- Gas Price Slider -->
            <SeekBar
                android:id="@+id/seekbar_fee"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:max="200"
                android:progress="50"
                android:thumb="@drawable/seekbar_thumb_black"
                android:progressDrawable="@drawable/seekbar_progress_black"
                android:splitTrack="false" />
 
            <!-- Slider Labels (clickable presets, positioned at actual Gwei values) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- spacer: 0 -> Slow (20/200) -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="20" />

                <TextView
                    android:id="@+id/label_slow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slow"
                    android:textColor="#888888"
                    android:textSize="20sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- spacer: Slow(20) -> Medium(50) = 30/200 -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="30" />

                <TextView
                    android:id="@+id/label_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:textColor="#888888"
                    android:textSize="20sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- spacer: Medium(50) -> Fast(100) = 50/200 -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="50" />

                <TextView
                    android:id="@+id/label_fast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fast"
                    android:textColor="#888888"
                    android:textSize="20sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- spacer: Fast(100) -> end(200) = 100/200 -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="100" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Send Button -->
    <android.widget.Button
        android:id="@+id/btn_send"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/custom_button_background"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/activity_send_send"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_size_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>