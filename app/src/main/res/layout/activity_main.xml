<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include android:id="@+id/action_bar" layout="@layout/topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp">

            <Spinner
                android:id="@+id/accountSpinner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/WTextview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/activity_main_add_account_first"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tsv_dollar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/activity_main_add_account_tip"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/send"
                    style="@style/WalletHomeAction"
                    android:drawableTop="@drawable/send_icon"
                    android:text="@string/activity_main_send" />

                <TextView
                    android:id="@+id/receiveicon"
                    style="@style/WalletHomeAction"
                    android:drawableTop="@drawable/qrcode_icon"
                    android:text="@string/activity_main_receive" />

                <TextView
                    android:id="@+id/swap"
                    style="@style/WalletHomeAction"
                    android:drawableTop="@drawable/transaction_icon"
                    android:text="@string/activity_main_swap" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/token_home_label"
                    android:textColor="@android:color/black"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/token_entry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/home_view_all"
                    android:textColor="@android:color/black"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wallet_asset_card"
                android:divider="@drawable/wallet_asset_divider"
                android:orientation="vertical"
                android:showDividers="middle">

                <include android:id="@+id/home_bkc_row" layout="@layout/wallet_asset_row" />
                <include android:id="@+id/home_wbkc_row" layout="@layout/wallet_asset_row" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_liquidity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/wallet_asset_card"
                android:drawableEnd="@drawable/right"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_pool_stack"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:text="@string/home_provide_liquidity"
                android:textColor="@android:color/black"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/accounts"
                    style="@style/WalletHomeAction"
                    android:drawableTop="@drawable/user_icon"
                    android:text="@string/activity_main_account" />

                <TextView
                    android:id="@+id/broker"
                    style="@style/WalletHomeAction"
                    android:drawableTop="@drawable/line_chart_icon"
                    android:text="@string/activity_main_brokerfi" />

                <TextView
                    android:id="@+id/news"
                    style="@style/WalletHomeAction"
                    android:drawableTop="@drawable/newspaper_icon"
                    android:text="@string/activity_main_news" />

                <TextView
                    android:id="@+id/community"
                    style="@style/WalletHomeAction"
                    android:drawableTop="@drawable/dao_team_icon"
                    android:text="@string/activity_main_community" />
            </LinearLayout>

            <TextView
                android:id="@+id/buy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/plus_icon"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/home_test_faucet"
                android:textColor="@android:color/black"
                android:textSize="15sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/activity_main_disclaimer_agreement"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
